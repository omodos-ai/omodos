type PendingFile struct {
	Path    string
	Content string
}

func printFileHelp() {
	fmt.Println("\n--- File Management Subsystem ---")
	fmt.Println("Manage pending code proposals generated by the AI.")
	fmt.Println("\nCommands:")
	fmt.Println("  file list           (Aliases: fl)        - Show pending AI file edits.")
	fmt.Println("  file write [idx...] (Aliases: fw, wf)    - Apply pending edits to disk (Time Machine backed).")
	fmt.Println("  file merge [idx...] (Aliases: fm)        - Generate .proposed files and trigger your diff_cmd.")
	fmt.Println("  file clear          (Aliases: fc)        - Cancel all pending edits.")
	fmt.Println()
}

func handleFileRouter(cmd string, parts []string) {
	if cmd == "fl" || (cmd == "file" && len(parts) > 1 && parts[1] == "list") {
		handleFL()
	} else if cmd == "fw" || cmd == "wf" || cmd == "write-files" || (cmd == "file" && len(parts) > 1 && parts[1] == "write") {
		args := extractFileArgs(cmd, parts)
		handleFW(args)
	} else if cmd == "fm" || (cmd == "file" && len(parts) > 1 && parts[1] == "merge") {
		args := extractFileArgs(cmd, parts)
		handleFM(args)
	} else if cmd == "fc" || (cmd == "file" && len(parts) > 1 && parts[1] == "clear") {
		handleFC()
	} else {
		printFileHelp()
	}
}

func extractFileArgs(cmd string, parts []string) []string {
	if cmd == "file" && len(parts) > 2 {
		return parts[2:]
	} else if cmd != "file" && len(parts) > 1 {
		return parts[1:]
	}
	return []string{}
}

func extractPendingFiles(responseText string) []PendingFile {
	re := regexp.MustCompile(`(?s)<file\s+path="([^"]+)"[^>]*>(.*?)</file>`)
	matches := re.FindAllStringSubmatch(responseText, -1)

	var files []PendingFile
	for _, match := range matches {
		path := match[1]
		content := match[2]
		content = strings.TrimPrefix(content, "\n")
		content = strings.TrimSuffix(content, "\n")
		files = append(files, PendingFile{Path: path, Content: content})
	}
	return files
}

func getTargetFiles(files []PendingFile, args []string) ([]PendingFile, error) {
	var targets []PendingFile
	if len(args) > 0 {
		for _, p := range args {
			idx, err := strconv.Atoi(p)
			if err != nil || idx < 0 || idx >= len(files) {
				return nil, fmt.Errorf("invalid file index: %s", p)
			}
			targets = append(targets, files[idx])
		}
	} else {
		targets = files
	}
	return targets, nil
}

func handleFL() {
	if lastAPIResponse == "" {
		fmt.Println("\n[Info] No pending files from the last AI response.")
		return
	}

	files := extractPendingFiles(lastAPIResponse)
	if len(files) == 0 {
		fmt.Println("\n[Info] No <file> blocks found in the last AI response.")
		return
	}

	fmt.Println("\n--- Pending AI File Edits ---")
	for i, f := range files {
		status := "\033[33mReady to apply\033[0m"

		if existing, err := os.ReadFile(f.Path); err == nil {
			if string(existing) == f.Content {
				status = "\033[32mMatches disk (Already applied)\033[0m"
			} else {
				status = "\033[31mFile exists (Will overwrite)\033[0m"
			}
		} else if !os.IsNotExist(err) {
			status = fmt.Sprintf("\033[31mError reading disk: %v\033[0m", err)
		}

		fmt.Printf("[%d] %-30s [%s]\n", i, f.Path, status)
	}
	fmt.Println("\n(Commands: 'fw' to write all, 'fm <index>' to inspect diff, 'fc' to cancel)")
}

func handleFW(args []string) {
	if lastAPIResponse == "" {
		fmt.Println("[!] No pending files to write.")
		return
	}

	files := extractPendingFiles(lastAPIResponse)
	if len(files) == 0 {
		fmt.Println("[!] No <file> blocks found in the last AI response.")
		return
	}

	targets, err := getTargetFiles(files, args)
	if err != nil {
		fmt.Printf("[Error] %v\n", err)
		return
	}

	err = core.ExecuteTransaction("write_files", func(anchor string, now time.Time) error {
		for _, f := range targets {
			err := os.MkdirAll(filepath.Dir(f.Path), 0755)
			if err != nil {
				return fmt.Errorf("failed to create directory for %s: %v", f.Path, err)
			}

			err = os.WriteFile(f.Path, []byte(f.Content), 0644)
			if err != nil {
				return fmt.Errorf("failed to write %s: %v", f.Path, err)
			}

			fmt.Printf("\033[32m[✓] Overwrote:\033[0m %s\n", f.Path)
		}
		return nil
	})

	if err != nil {
		fmt.Printf("\033[31m[Error]\033[0m %v\n", err)
	} else {
		fmt.Printf("[Info] Successfully applied %d file modification(s).\n", len(targets))
	}
}

func handleFM(args []string) {
	if lastAPIResponse == "" {
		fmt.Println("[!] No pending files to merge.")
		return
	}

	files := extractPendingFiles(lastAPIResponse)
	if len(files) == 0 {
		fmt.Println("[!] No <file> blocks found in the last AI response.")
		return
	}

	targets, err := getTargetFiles(files, args)
	if err != nil {
		fmt.Printf("[Error] %v\n", err)
		return
	}

	diffCmdStr := core.ProjectViper.GetString("diff_cmd")
	if diffCmdStr == "" {
		diffCmdStr = "diff -u" // Default unified diff
	}
	diffCmdParts := strings.Fields(diffCmdStr)

	for _, f := range targets {
		proposedPath := f.Path + ".proposed"
		err := os.MkdirAll(filepath.Dir(proposedPath), 0755)
		if err != nil {
			fmt.Printf("[Error] Failed to create directory for %s: %v\n", proposedPath, err)
			continue
		}

		err = os.WriteFile(proposedPath, []byte(f.Content), 0644)
		if err != nil {
			fmt.Printf("[Error] Failed to write %s: %v\n", proposedPath, err)
			continue
		}

		fmt.Printf("\n\033[35m[Info] Generated proposed file:\033[0m %s\n", proposedPath)

		if _, statErr := os.Stat(f.Path); statErr == nil {
			fmt.Printf("=> Executing: %s %s %s\n\n", diffCmdStr, f.Path, proposedPath)
			cmdArgs := append(diffCmdParts[1:], f.Path, proposedPath)
			cmd := exec.Command(diffCmdParts[0], cmdArgs...)
			cmd.Stdout = os.Stdout
			cmd.Stderr = os.Stderr
			cmd.Run() // diff natively exits 1 if files differ, so we ignore the error
		} else {
			fmt.Printf("=> Original file %s does not exist yet. Cannot perform merge/diff.\n", f.Path)
		}
	}
}

func handleFC() {
	lastAPIResponse = ""
	fmt.Println("[✓] Pending files queue cleared.")
}

func handleCR() {
	if lastAPIResponse == "" {
		fmt.Println("[!] No recent response to copy.")
		return
	}

	textToCopy := cleanForClipboard(lastAPIResponse)
	err := clipboard.WriteAll(textToCopy)
	if err != nil {
		fmt.Printf("[Error] Cannot write to OS clipboard: %v\n", err)
	} else {
		fmt.Println("[✓] Response copied to clipboard (ready to paste).")
	}
}

func handleCW(parts []string) {
	if len(parts) < 2 {
		fmt.Println("Usage: cw <path>")
		return
	}
	if lastAPIResponse == "" {
		fmt.Println("[!] No recent response to write.")
		return
	}

	path := parts[1]
	textToWrite := cleanForClipboard(lastAPIResponse)

	err := os.WriteFile(path, []byte(textToWrite), 0644)
	if err != nil {
		fmt.Printf("[Error] Failed to write file: %v\n", err)
	} else {
		fmt.Printf("[✓] Response safely written to %s\n", path)
	}
}

func cleanForClipboard(text string) string {
	ticks := "\x60\x60\x60"
	re := regexp.MustCompile(`(?s)` + ticks + `[a-zA-Z0-9]*\n(.*?)\n` + ticks)
	matches := re.FindAllStringSubmatch(text, -1)

	if len(matches) > 0 {
		var sb strings.Builder
		for _, m := range matches {
			snippet := m[1]
			snippet = strings.ReplaceAll(snippet, "\x00", "")
			snippet = strings.ReplaceAll(snippet, "\x1b", "")
			sb.WriteString(snippet + "\n\n")
		}
		return strings.TrimSpace(sb.String())
	}

	text = strings.ReplaceAll(text, "**", "")
	text = strings.ReplaceAll(text, "__", "")
	text = strings.ReplaceAll(text, "### ", "")
	text = strings.ReplaceAll(text, "## ", "")
	text = strings.ReplaceAll(text, "# ", "")
	text = strings.ReplaceAll(text, "\x00", "")
	text = strings.ReplaceAll(text, "\x1b", "")

	return strings.TrimSpace(text)
}
